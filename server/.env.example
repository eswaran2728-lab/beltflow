# Copy this file to server/.env and fill in real values for your
# environment. Never commit the resulting .env file (it is gitignored).

# Required in production - the process will refuse to start auth without
# it (server/src/security/crypto.ts). In development/test, an ephemeral
# random secret is generated automatically if this is left unset.
JWT_SECRET=

# PostgreSQL connection string. If unset, the backend falls back to an
# embedded PGlite database on local disk (server/src/db/client.ts) - fine
# for local development, not appropriate for a real production deployment.
DATABASE_URL=

# Marks this process as a production deployment. Enables the JWT_SECRET
# requirement above and disables verbose error messages in API responses.
NODE_ENV=production

# Port the Express server listens on. Defaults to 4000.
PORT=4000

# Comma-separated list of browser origins allowed to call this API
# (e.g. https://app.beltflow.example). Native Android clients are
# unaffected either way - they don't send a browser Origin header. If
# left unset in production, the server logs a warning and allows all
# origins.
CORS_ALLOWED_ORIGINS=

# Only used when DATABASE_URL is unset (embedded PGlite mode) - where the
# local database files are stored. Defaults to ./.beltflow_pgdata.
PG_DATA_DIR=

# Controls whether the DATABASE_URL connection uses SSL. Defaults to "on"
# when NODE_ENV=production (most managed PostgreSQL providers require it)
# and "off" otherwise. Set to "disable" if your production/staging
# PostgreSQL instance does not have SSL configured, or "require" to force
# it on outside of production.
DATABASE_SSL=

# ---------------------------------------------------------------------------
# H26 Role-Aware Grounded AI assistant (read-only). All optional.
# The default provider is offline/extractive: no API key, no network call.
# No live AI provider is wired in yet; when one is added, its API key must
# be set here on the server only - never in the mobile app.
# ---------------------------------------------------------------------------
# Set to "false" to switch the assistant off (its routes then return 404).
AI_ASSISTANT_ENABLED=
# Questions per user per minute (default 20).
AI_RATE_LIMIT_PER_MINUTE=
# Daily token budget per Persatuan (default 200000) and per user (default 20000).
AI_DAILY_TOKEN_BUDGET_PER_ORG=
AI_DAILY_TOKEN_BUDGET_PER_ACTOR=
# Maximum question length in characters (default 500).
AI_MAX_QUERY_CHARS=
# Maximum answer tokens requested from a provider (default 600).
AI_MAX_OUTPUT_TOKENS=
# Provider timeout in milliseconds (default 15000).
AI_PROVIDER_TIMEOUT_MS=
# Secret key for hashing questions in ai_audit_events. If unset, a random
# per-process key is used (hashes then cannot be compared across restarts).
# Generate with: openssl rand -hex 32
AI_AUDIT_HASH_KEY=
